# Copy to .env (repo root) for `docker compose up`. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the filled-in file.

ENVIRONMENT=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

SECRET_KEY=
POSTGRES_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=lookbook
MINIO_ROOT_PASSWORD=

# Bot protection (https://dash.cloudflare.com -> Turnstile). Required in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email for password resets. Without SMTP (development only) messages go to storage/dev-outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=LOOKBOOK <no-reply@example.com>

# AI providers: any subset. With none, the app runs in mock mode.
GEMINI_API_KEY=
REPLICATE_API_TOKEN=
DECART_API_KEY=
GPU_WORKER_URL=
GPU_WORKER_TOKEN=

# Cost controls and alerting (Slack/Discord incoming webhook URL).
DAILY_PAID_CALL_BUDGET=1000
DAILY_TRYONS_PER_USER=50
ALERT_WEBHOOK_URL=
