# Local development without Docker (see README). Copy to backend/.env.
# With no AI keys the app runs fully in mock mode.
ENVIRONMENT=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

DATABASE_URL=postgresql+psycopg://lookbook_app:app_dev_pw@localhost:5432/lookbook
MIGRATION_DATABASE_URL=postgresql+psycopg://lookbook_owner:owner_dev_pw@localhost:5432/lookbook
REDIS_URL=redis://localhost:6379/0

# "local" = encrypted files in backend/storage served via signed URLs; "s3" = S3/R2/MinIO.
STORAGE_BACKEND=local
SECRET_KEY=dev-only-insecure-secret-change-me

# Leave empty in development to skip the human check. Required in production.
TURNSTILE_SECRET_KEY=

# AI providers (any subset). Empty = mock mode.
GEMINI_API_KEY=
REPLICATE_API_TOKEN=
DECART_API_KEY=
GPU_WORKER_URL=
GPU_WORKER_TOKEN=
