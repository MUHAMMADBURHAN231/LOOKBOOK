# Copy to backend/.env and fill in. With no keys set, LOOKBOOK runs in mock mode.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6L8M01fyGho6_j1ArT36y3JZeTOVXf6PSXJBCZR4Qy_Eg

# Replicate token (only needed for the "vton" pipeline): https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Force mock mode even when keys are present (true/false). Empty = auto (mock when keys are missing).
MOCK_MODE=

# Default generation pipeline: "edit" (Gemini image editing, handles scenes) or "vton" (garment image + IDM-VTON).
DEFAULT_PIPELINE=edit

# Model overrides
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_STYLIST_MODEL=gemini-2.5-pro
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
REPLICATE_GARMENT_MODEL=black-forest-labs/flux-schnell
REPLICATE_VTON_MODEL=cuuupid/idm-vton
REPLICATE_RESTORE_MODEL=sczhou/codeformer

# Privacy: uploads and generated images older than this are deleted on startup.
RETENTION_DAYS=30

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
