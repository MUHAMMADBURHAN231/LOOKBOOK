# Browser-facing API origin
NEXT_PUBLIC_API_URL=http://localhost:8000
# Cloudflare Turnstile site key (public). Empty in development skips the human check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Origin of presigned storage URLs when using S3/R2/MinIO (e.g. http://localhost:9000). Empty for local storage.
NEXT_PUBLIC_STORAGE_ORIGIN=
# Server-side API origin for the proxy (inside Docker: http://api:8000). Defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
